    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "prettier": "^3.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "@typescript-eslint/typescript-estree": {
